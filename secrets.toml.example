# Example of the secrets you paste into Streamlit Community Cloud
# (App settings > Secrets). For local use you can copy this file to
# ".streamlit/secrets.toml" (it is git-ignored). Only add the LLM key you use.

GROQ_API_KEY = "your_groq_api_key_here"
OPENAI_API_KEY = "your_openai_api_key_here"
GEMINI_API_KEY = "your_gemini_api_key_here"
ELEVENLABS_API_KEY = "your_elevenlabs_api_key_here"
